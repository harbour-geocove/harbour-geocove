[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-geocove
Exec=sailfish-qml harbour-geocove
Name=GeoCove
# translation example:
# your app name in German locale (de)
#
# Remember to comment out the following line, if you do not want to use
# a different app name in German locale (de).
#Name[de]=harbour-geocove

[X-Sailjail]
OrganizationName=org.geocove
ApplicationName=harbour-geocove
Permissions=Internet;Location;Documents
